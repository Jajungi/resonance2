    {
      "id": "r1",
      "tags": [
        "신앙",
        "마음"
      ],
      "text": "기도했는데 대답이 없는 것 같았습니다. 그래도 오늘 여기 와서 말했습니다."
    },
    {
      "id": "r2",
      "tags": [
        "그리움",
        "애도"
      ],
      "text": "젊은 친구가 문득 생각납니다. 이름을 부르기만 해도 가슴이 먹먹합니다."
    },
    {
      "id": "r3",
      "tags": [
        "외로움",
        "직장"
      ],
      "text": "사람은 많은데, 이야기를 끝까지 들어주는 사람은 없었습니다."
    },
    {
      "id": "r4",
      "tags": [
        "미움",
        "용서"
      ],
      "text": "미운 마음이 남아 있었습니다. 오늘은 같은 말로 갚지 않고 여기 두고 갑니다."
    },
    {
      "id": "r5",
      "tags": [
        "의미",
        "청년",
        "불안"
      ],
      "text": "일이 안 풀려 내가 필요 없는 사람 같았습니다. 그래도 한 마디는 남겼습니다."
    },
    {
      "id": "r6",
      "tags": [
        "가족",
        "돌봄피로"
      ],
      "text": "누군가를 돌보다가 제 마음은 어디에 두었는지 모르겠었습니다."
    },
    {
      "id": "r7",
      "tags": [
        "신앙",
        "의미"
      ],
      "text": "믿지는 않는데, 두고 갈 곳이 필요해서 왔습니다."
    },
    {
      "id": "r8",
      "tags": [
        "감사",
        "마음"
      ],
      "text": "고마운 일이 있는데 말할 곳이 없었습니다. 오늘은 여기 한 줄 두었습니다."
    }
  ]
