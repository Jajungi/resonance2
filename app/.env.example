# 1이면 Groq/Ollama 호출 안 함 (demo·템플릿만, 토큰 절약)
AI_DISABLED=1

# 서버 포트
PORT=8787

# Groq (https://console.groq.com) — 있으면 우선 사용
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama 로컬 (Groq 없을 때) — 예: http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# 프로덕션에서 클라이언트 정적 파일 제공 시
# NODE_ENV=production
